# Copy to .env and fill in. Everything is optional: with nothing set, the app runs in demo mode.

PORT=3000
# Protects the dashboard with a password (username can be anything). The /report pages stay public.
APP_PASSWORD=

# --- AI (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cheaper model used for bulk thread scoring
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# --- Reddit (create a "script" app at https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Only needed for one-click posting. Leave blank to search only and post by hand.
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=web:threadscout:1.0 (by /u/yourname)

# --- Weekly lead digest email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Where the JSON database lives
DATA_DIR=./data
